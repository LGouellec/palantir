# ---- What to scrape (set at least one of QUERIES / USERS) ----
# Comma-separated search queries (supports X search operators, e.g. "$TSLA", "AAPL lang:en -filter:replies")
TWITTER_QUERIES=$TSLA,$NVDA,$AAPL
# Comma-separated usernames (no @) whose timelines to pull
TWITTER_USERS=DeItaone,FirstSquawk
# Top | Latest | Photos | Videos | Users
SEARCH_MODE=Latest
# Max tweets per query / per user
MAX_TWEETS=50
# Delay between requests, milliseconds
DELAY_MS=1500
# Only fetch tweets at/after this point. "today" = start of the current UTC day
# (rolls forward in continuous mode), or a fixed "YYYY-MM-DD". Empty = no bound.
# Applied via the search `since:` operator and a client-side filter on timelines.
SINCE=today

# ---- Run mode ----
CONTINUOUS=false
CONTINUOUS_INTERVAL=300
VERBOSE=true

# ---- Authentication (cookies strongly preferred over login) ----
# Path to a JSON cookies file. On a successful credential login, fresh cookies
# are written back here so subsequent runs skip login.
TWITTER_COOKIES_FILE=cookies.json
# Or paste a raw cookie string exported from your browser:
# TWITTER_COOKIES=auth_token=xxx; ct0=yyy
# Credential login (last resort — account may be banned):
# TWITTER_USERNAME=
# TWITTER_PASSWORD=
# TWITTER_EMAIL=

# ---- Kafka ----
KAFKA_ENABLED=false
KAFKA_TOPIC=twitter-tweets
# Local docker-compose broker:
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# Or a Confluent Cloud properties file (overridden by KAFKA_BOOTSTRAP_SERVERS):
# KAFKA_CONFIG_FILE=kafka_config.properties

# ---- History / dedup ----
HISTORY_FILE=history/scraped_history.json
HISTORY_TTL_DAYS=30

# ---- Local output ----
SAVE_LOCAL=false
OUTPUT_DIR=output
