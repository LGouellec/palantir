{
  "name": "twitter-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Twitter/X scraper for the Palantir trading engine, built on @the-convocation/twitter-scraper and producing to Kafka.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@the-convocation/twitter-scraper": "^0.22.3",
    "dotenv": "^16.4.5",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/tough-cookie": "^4.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
