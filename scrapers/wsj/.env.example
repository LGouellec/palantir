# Azure Configuration
ACR_NAME=your-acr-name
RESOURCE_GROUP=wsj-scraper-rg
AKS_CLUSTER=wsj-scraper-aks
LOCATION=eastus

# Docker Image
IMAGE_TAG=latest

# Kubernetes
NAMESPACE=default

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka.kafka.svc.cluster.local:9092
KAFKA_TOPIC=wsj-articles

# Scraper Configuration
DELAY=2.0

# Section-specific limits
TECH_AI_LIMIT=100
MARKETS_LIMIT=200
OPINION_LIMIT=75
BUSINESS_LIMIT=150
WORLD_LIMIT=180

# Schedules (cron format)
TECH_AI_SCHEDULE="0 */2 * * *"
MARKETS_SCHEDULE="30 */3 * * *"
OPINION_SCHEDULE="15 */4 * * *"
BUSINESS_SCHEDULE="45 */6 * * *"
WORLD_SCHEDULE="20 */3 * * *"

# Base URLs
TECH_AI_URL=https://www.wsj.com/tech/ai?page=1
MARKETS_URL=https://www.wsj.com/markets?page=1
OPINION_URL=https://www.wsj.com/opinion?page=1
BUSINESS_URL=https://www.wsj.com/business?page=1
WORLD_URL=https://www.wsj.com/world?page=1
