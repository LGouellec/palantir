# Alpaca API credentials. Get these from your Alpaca dashboard
# (paper or live account, matching APCA_PAPER below).
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_PAPER=true

# Optional: override where the local SQLite cache is stored.
# Defaults to dashboard/data/orders.db next to this file.
# DASHBOARD_DB_PATH=