# Copy to .env and fill in. docker compose auto-loads .env from this directory.
#   cp .env.example .env
#
# Each fetcher only reads its own variables, so you only need to fill in the
# section for the service(s) you bring up.

# ── Shared ──────────────────────────────────────────────────────────────────
# Broker the fetchers produce to. Leave as-is to use the bundled `kafka` service.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ── Alpaca real-time news (service: alpaca-news) ─────────────────────────────
# Credentials from https://app.alpaca.markets (Home -> API Keys). Required.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Comma-separated tickers, or "*" for all news. Default: *
NEWS_SYMBOLS=*
# Destination Kafka topic. Default: news.realtime
NEWS_TOPIC=news.realtime
# Include the full article body in each message. Default: true
INCLUDE_CONTENT=true

# ── Longbridge real-time quotes/depth (service: longbridge-shard) ────────────
# Credentials from https://open.longportapp.com. Required for longbridge-shard.
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_ACCESS_TOKEN=
